# ── Required ──────────────────────────────────────────────────────────────────
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_api_key_here

# ── Optional: live Slack delivery ─────────────────────────────────────────────
# Leave blank to run in demo mode — approved Slack alerts are rendered in the
# dashboard instead of being transmitted.
SLACK_WEBHOOK_URL=

# ── Optional: live email delivery ─────────────────────────────────────────────
# Leave blank to run in demo mode — approved RFQ emails are rendered in the
# dashboard instead of being sent. Mailtrap's sandbox is a safe place to test:
# https://mailtrap.io
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=chainpilot@example.com
